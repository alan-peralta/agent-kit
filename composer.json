{
    "name": "peralta/agent-kit",
    "description": "AI agents toolkit for Laravel with multi-provider support, tools and RAG.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "ai", "agents", "openai", "anthropic", "gemini", "deepseek", "rag", "pgvector", "mysql", "mariadb", "postgresql"],
    "authors": [
        {
            "name": "Peralta"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0|^8.0"
    },
    "conflict": {
        "mcp/sdk": "<0.8.1 || >=0.9"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "require-dev": {
        "mcp/sdk": "^0.8.1",
        "nikic/php-parser": "^5.8",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "pgvector/pgvector": "^0.2"
    },
    "suggest": {
        "mcp/sdk": "Required by the MCP server (php artisan agent-kit:mcp), ^0.8.1; install it with --dev",
        "nikic/php-parser": "Required by the Refactoring Agent's AST capabilities (analyze, callers, dependencies, impact), ^5.0; install it with --dev",
        "pgvector/pgvector": "Required for pgvector knowledge store",
        "smalot/pdfparser": "For extracting text from PDF documents",
        "phpoffice/phpword": "For extracting text from DOCX documents"
    },
    "autoload": {
        "psr-4": {
            "Peralta\\AgentKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Peralta\\AgentKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Peralta\\AgentKit\\AgentKitServiceProvider"
            ],
            "aliases": {
                "Agent": "Peralta\\AgentKit\\Facades\\Agent"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
