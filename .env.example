# ============================================================================
# AGENT KIT - Configuração de Ambiente
# ============================================================================

# ============================================================================
# LLM PROVIDERS
# ============================================================================

# Provider padrão: openai, anthropic, gemini, deepseek
AGENT_PROVIDER=anthropic

# OpenAI
OPENAI_API_KEY=sk-xxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-opus-4-5

# Google Gemini
GEMINI_API_KEY=xxxxx
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ============================================================================
# CONVERSAS (CONVERSATION STORAGE)
# ============================================================================

# Driver: array, database, redis, hybrid
# - array: sem persistência (memória)
# - database: PostgreSQL/MySQL (permanente)
# - redis: Redis (rápido, expira)
# - hybrid: Redis (rápido) + Database (permanente)
AGENT_CONVERSATION_DRIVER=hybrid

# Configuração do Redis (para drivers: redis, hybrid)
AGENT_CONVERSATION_REDIS=default
AGENT_CONVERSATION_REDIS_PREFIX=agent:conv:
# TTL em segundos (30 dias = 2592000)
# Exemplos: 3600 (1h), 86400 (1 dia), 604800 (7 dias), 2592000 (30 dias)
AGENT_CONVERSATION_REDIS_TTL=2592000

# Configuração do Database (para drivers: database, hybrid)
AGENT_CONVERSATION_DB=pgsql  # ou mysql, sqlite, etc
# AGENT_CONVERSATION_DB_CONNECTION=  # null = usa conexão default

# ============================================================================
# KNOWLEDGE BASE (RAG)
# ============================================================================

# Embedder para gerar vetores dos documentos: openai, gemini, cohere
AGENT_EMBEDDER=openai

# Knowledge Store: pgvector ou qdrant
AGENT_KNOWLEDGE_STORE=pgvector
AGENT_KNOWLEDGE_DB=pgsql

# Qdrant Cloud ou self-hosted (usado quando AGENT_KNOWLEDGE_STORE=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks
QDRANT_TIMEOUT=30
QDRANT_BATCH_SIZE=100

# ============================================================================
# EMBEDDERS (para RAG)
# ============================================================================

# OpenAI Embeddings (recomendado)
OPENAI_EMBEDDER_MODEL=text-embedding-3-small
OPENAI_EMBEDDER_DIMENSIONS=1536

# Google Gemini Embeddings (grátis)
# GEMINI_API_KEY=xxxxx
# Retorna automaticamente 768 dimensões

# Cohere Embeddings (multilíngue premium)
# COHERE_API_KEY=xxxxx
COHERE_EMBEDDER_MODEL=embed-english-v3.0
# Opções: embed-english-v3.0 (1024 dims)
#         embed-english-light-v3.0 (384 dims)
#         embed-multilingual-v3.0 (1024 dims)
#         embed-multilingual-light-v3.0 (384 dims)
COHERE_EMBEDDER_INPUT_TYPE=search_document

# Mistral Embeddings (custo-benefício)
# MISTRAL_API_KEY=xxxxx
MISTRAL_EMBEDDER_MODEL=mistral-embed
# Retorna automaticamente 1024 dimensões

# AWS Bedrock Titan Embeddings (enterprise)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=xxxxx
# AWS_SECRET_ACCESS_KEY=xxxxx
AWS_EMBEDDER_MODEL=amazon.titan-embed-text-v2:0
# Opções: amazon.titan-embed-text-v2:0 (1536 dims)
#         amazon.titan-embed-text-v1 (1024 dims)

# ============================================================================
# LOGGING
# ============================================================================

AGENT_LOGGING=true
AGENT_LOG_CHANNEL=stack
AGENT_LOG_TOOL_CALLS=true
AGENT_LOG_MESSAGES=false  # cuidado: pode expor dados sensíveis (PII)

# ============================================================================
# ERROR RECOVERY (retry, fallback entre providers e alertas)
# ============================================================================

AGENT_ERROR_RECOVERY_ENABLED=true

# Alerta no Discord quando um fallback é ativado ou todos os providers falham
AGENT_DISCORD_ALERTS_ENABLED=false
AGENT_DISCORD_WEBHOOK_URL=
AGENT_DISCORD_MENTION=@oncall

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================

AGENT_KIT_ANALYTICS_ENABLED=true
# Persiste cada evento de analytics na tabela agent_kit_metrics
AGENT_KIT_ANALYTICS_PERSIST=false

# ============================================================================
# EXEMPLOS DE CONFIGURAÇÃO
# ============================================================================

# Exemplo 1: Chatbot simples (sem histórico)
# AGENT_CONVERSATION_DRIVER=array
# AGENT_PROVIDER=anthropic

# Exemplo 2: Chatbot com histórico em Redis (conversas ativas)
# AGENT_CONVERSATION_DRIVER=redis
# AGENT_CONVERSATION_REDIS_TTL=604800  # 7 dias

# Exemplo 3: Suporte técnico com auditoria completa (seu caso!)
# AGENT_CONVERSATION_DRIVER=hybrid
# AGENT_CONVERSATION_REDIS_TTL=2592000  # 30 dias no Redis
# AGENT_CONVERSATION_DB=pgsql  # Permanente no PostgreSQL

# Exemplo 4: Conversas muito longas (não expira)
# AGENT_CONVERSATION_DRIVER=database
# (histórico fica permanente no banco)

# Exemplo 5: Redis com TTL curto (1 dia)
# AGENT_CONVERSATION_DRIVER=hybrid
# AGENT_CONVERSATION_REDIS_TTL=86400  # 1 dia
